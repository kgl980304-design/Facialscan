require "base64"

default_platform(:ios)

platform :ios do
  desc "[1회성] Distribution 인증서를 생성해서 .p12로 내보냄 (bootstrap-cert.yml 전용)"
  lane :bootstrap_cert do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )

    cert(
      api_key: api_key,
      team_id: ENV["TEAM_ID"],
      development: false,
      force: true,
      keychain_path: "#{lane_context[SharedValues::KEYCHAIN_PATH]}-db",
      keychain_password: ENV
