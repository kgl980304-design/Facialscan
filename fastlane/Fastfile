require "base64"

default_platform(:ios)

platform :ios do
  desc "[1회성] Distribution 인증서를 생성해서 .p12로 내보냄 (bootstrap-cert.yml 전용)"
  lane :bootstrap_cert do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )

    cert(
      api_key: api_key,
      team_id: ENV["TEAM_ID"],
      development: false,
      force: true,
      keychain_path: "#{lane_context[SharedValues::KEYCHAIN_PATH]}-db",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    keychain_path = File.expand_path("#{lane_context[SharedValues::KEYCHAIN_PATH]}-db")
    output_path = File.join(ENV["GITHUB_WORKSPACE"] || Dir.pwd, "distribution.p12")

    sh("security export -k '#{keychain_path}' -t identities -f pkcs12 " \
       "-o '#{output_path}' -P '#{ENV['CERT_EXPORT_PASSWORD']}'")

    UI.success("distribution.p12 생성 완료: #{output_path}")
  end

  desc "빌드 후 TestFlight로 업로드 (GitHub Actions macOS 러너에서 실행)"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )

    # Distribution 인증서는 Apple 계정당 개수 제한이 있어서 매번 새로
    # 만들면 금방 한도를 초과한다. bootstrap_cert lane으로 미리 만들어
    # GitHub Secret에 저장해둔 .p12를 그대로 불러와 재사용한다.
    cert_p12_path = File.join(ENV["GITHUB_WORKSPACE"] || Dir.pwd, "distribution.p12")
    File.open(cert_p12_path, "wb") do |f|
      f.write(Base64.decode64(ENV["DIST_CERT_P12_BASE64"]))
    end

    keychain_path = File.expand_path("#{lane_context[SharedValues::KEYCHAIN_PATH]}-db")

    import_certificate(
      certificate_path: cert_p12_path,
      certificate_password: ENV["DIST_CERT_PASSWORD"],
      keychain_path: keychain_path,
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    sigh(
      api_key: api_key,
      team_id: ENV["TEAM_ID"],
      app_identifier: "com.facialscancalib.app",
      development: false,
      force: true,
      provisioning_name: "FacialScanCalib AppStore CI"
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "FacialScanCalib.xcodeproj"
    )

    build_app(
      workspace: "FacialScanCalib.xcworkspace",
      scheme: "FacialScanCalib",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['TEAM_ID']} PROVISIONING_PROFILE_SPECIFIER=\"#{lane_context[SharedValues::SIGH_NAME]}\""
    )

    # upload_to_testflight(pilot)이 내부적으로 재생성하는 임시 AuthKey 파일이
    # 비어버리는 문제가 있어, Apple의 altool을 직접 호출한다. altool은
    # ./private_keys/AuthKey_<KeyID>.p8 파일(원본 PKCS8 형식)을 자동으로
    # 찾아서 인증하므로 별도 경로 지정 없이 --apiKey/--apiIssuer만 넘기면 된다.
    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]

    sh("xcrun altool --upload-app -f '#{ipa_path}' -t ios " \
       "--apiKey #{ENV['ASC_KEY_ID']} --apiIssuer #{ENV['ASC_ISSUER_ID']}")
  end

  desc "빌드만 하고 .ipa를 아티팩트로 남김 (TestFlight 없이 임시 배포용)"
  lane :adhoc_build do
    build_app(
      workspace: "FacialScanCalib.xcworkspace",
      scheme: "FacialScanCalib",
      export_method: "development",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}",
      output_directory: "build"
    )
  end
end
